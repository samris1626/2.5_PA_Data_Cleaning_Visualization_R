## STEP 1: REMOVE DUPLICATE ROWS
library(writexl)
library(readxl)
library(dplyr)
library(IRdisplay)

todays_date <- format(Sys.Date(), "%Y-%m-%d")
student_id <- "StudentID" # Replace with your actual Student ID

file_path <- "C:/Files/Excel/DA_PythonR/AirBnBSummary_v2.xlsx"
df <- read_excel(file_path)

duplicate_rows_before <- df[duplicated(df),]

display_markdown(paste("###", student_id, "-", todays_date))
display_markdown("### Duplicate Rows before cleaning")
display(duplicate_rows_before)

df_cleaned <- df %>% distinct()

duplicate_rows_after <- df_cleaned[duplicated(df_cleaned),]

display_markdown("### Duplicate Rows after cleaning")
display(duplicate_rows_after)


## STEP 2: FIX TYPOS
count_before <- table(df_cleaned$room_type)

df_cleaned$room_type <- ifelse(df_cleaned$room_type == "Private room", "Private Room", df_cleaned$room_type)

count_after <- table(df_cleaned$room_type)

replaced_count <- sum(df_cleaned$room_type == "Private Room") - ifelse("Private Room" %in% names(count_before), count_before["Private Room"], 0)

display_markdown(paste("###", student_id, "-", todays_date))
display_markdown(paste("**", replaced_count, "typos ('Private room' -> 'Private Room') were replaced.**"))


## STEP 3: HANDLE MISSING VALUES
missing_values_before <- sapply(df_cleaned, function(x) sum(is.na(x)))

display_markdown(paste("###", student_id, "-", todays_date))
display_markdown("### Number of missing values in each column before cleaning")
display(missing_values_before)

df_cleaned <- df_cleaned %>% 
  mutate(across(where(is.numeric), ~ ifelse(is.na(.), median(., na.rm = TRUE), .)))

missing_values_after <- sapply(df_cleaned, function(x) sum(is.na(x)))

display_markdown("### Number of missing values in each column after median imputation")
display(missing_values_after)


# STEP 4: REMOVE OUTLIERS
outliers <- list()
numerical_columns <- names(df_cleaned)[sapply(df_cleaned, is.numeric)]

for (col in numerical_columns) {
  Q1 <- quantile(df_cleaned[[col]], 0.25, na.rm = TRUE)
  Q3 <- quantile(df_cleaned[[col]], 0.75, na.rm = TRUE)
  IQR_val <- Q3 - Q1
  outliers[[col]] <- df_cleaned[(df_cleaned[[col]] < Q1 - 3.5 * IQR_val) | (df_cleaned[[col]] > Q3 + 3.5 * IQR_val), ]
}

display_markdown(paste("###", student_id, "-", todays_date))
display_markdown("### Outliers Before Replacement")
for (col in names(outliers)) {
  if (nrow(outliers[[col]]) > 0) {
    display_markdown(paste("**", col, ":**"))
    display(outliers[[col]][col])
  }
}

for (col in names(outliers)) {
  if (nrow(outliers[[col]]) > 0) {
    median_val <- median(df_cleaned[[col]], na.rm = TRUE)
    Q1 <- quantile(df_cleaned[[col]], 0.25, na.rm = TRUE)
    Q3 <- quantile(df_cleaned[[col]], 0.75, na.rm = TRUE)
    IQR_val <- Q3 - Q1
    outlier_idx <- which((df_cleaned[[col]] < Q1 - 3.5 * IQR_val) | (df_cleaned[[col]] > Q3 + 3.5 * IQR_val))
    df_cleaned[outlier_idx, col] <- median_val
  }
}

display_markdown("**Outliers replaced successfully with column medians.**")

## STEP 5: SAVE NEW FILE
cleaned_file_path <- "C:/Files/Excel/DA_PythonR/AirBnBSummary_v2_R_Cleaned.xlsx"
write_xlsx(df_cleaned, cleaned_file_path)
