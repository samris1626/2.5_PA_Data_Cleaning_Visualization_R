## VISUALIZATIONS
## HISTOGRAM
library(ggplot2)

current_datetime <- format(Sys.time(), "%Y-%m-%d %H:%M:%S")

ggplot(df_cleaned, aes(x = number_of_reviews)) +
  geom_histogram(binwidth = 5, fill = "skyblue", color = "black") +
  xlab("Number of Reviews") +
  ylab("Frequency") +
  ggtitle(paste("Histogram of Number of Reviews -", student_id, "-", current_datetime)) +
  theme_minimal() +
  theme(panel.grid.major = element_line(colour = "grey"))


## BAR CHART
ggplot(df_cleaned, aes(x = factor(minimum_nights))) +
  geom_bar(fill = "limegreen", color = "black") +
  xlab("Minimum Nights Required") +
  ylab("Count of Listings") +
  ggtitle(paste("Bar Chart of Minimum Nights -", student_id, "-", current_datetime)) +
  theme_minimal() +
  theme(panel.grid.major = element_line(colour = "grey"))


## SCATTER PLOT
ggplot(df_cleaned, aes(x = availability_365, y = price)) +
  geom_point(aes(color = "Data Points"), alpha = 0.6, size = 2) +
  geom_smooth(method = "lm", se = FALSE, aes(color = "Trendline"), linewidth = 1.2) +
  scale_color_manual(values = c("Data Points" = "blue", "Trendline" = "red")) +
  xlab("Availability (Days per Year)") +
  ylab("Price (USD)") +
  ggtitle(paste("Scatter Plot: Availability vs Price -", student_id, "-", current_datetime)) +
  theme_minimal() +
  theme(panel.grid.major = element_line(colour = "grey"), legend.title = element_blank())


## HEATMAP
library(corrplot)

# Select numeric columns
selected_cols <- df_cleaned %>% select(price, minimum_nights, number_of_reviews, availability_365)

# Calculate Correlation Matrix
cor_matrix <- cor(selected_cols, use = "pairwise.complete.obs")

# Render Heatmap
corrplot(cor_matrix, 
         method = "color", 
         type = "upper", 
         title = paste("Heatmap of Correlations -", student_id, "-", current_datetime),
         tl.col = "black", 
         tl.srt = 45, 
         number.cex = 0.8, 
         addCoef.col = "black",
         mar = c(0, 0, 2, 0))
